# Dependencies are declared per package; install via `pnpm install` at the repo root
node_modules/

# Build output — rebuild with: tsc -p tsconfig.build.json
dist/

# Model weights — exceed Gitee single-file limit; fetch via scripts/fetch-model.mjs
models/

# Runtime state (e.g. local-llama enabled flag)
.state/

# TypeScript incremental cache
*.tsbuildinfo

.DS_Store

# Local-only plugin: reads the WorkBuddy desktop app's credential vault (via a
# borrowed at-rest key) — must never be committed or pushed. Its history lives
# on the local-only branch `local-workbuddy-main`; pushes touching it are
# rejected by scripts/hooks/pre-push.
packages/dsh-connect-workbuddy/
